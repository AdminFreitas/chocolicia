# PostgreSQL (Neon)
DATABASE_URL=
# Optional alias used by drizzle-kit
NEON_DATABASE_URL=

# Session cookies for admin catalog login (use a long random string)
JWT_SECRET=

# Admin area (catalog upload on the home page)
ADMIN_PASSWORD=
ADMIN_OPEN_ID=chocolicia-admin

# Neon Object Storage (S3-compatible) for dynamic catalog images
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2
S3_BUCKET_NAME=assets

# Server port (default 3000)
PORT=3000
