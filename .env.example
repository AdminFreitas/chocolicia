# PostgreSQL/Neon: URL de ligação do servidor à base de dados.
DATABASE_URL=
# Alias opcional de DATABASE_URL usado pelo Drizzle Kit.
NEON_DATABASE_URL=
# Assinatura das sessões administrativas; definir como segredo aleatório forte.
JWT_SECRET=
# Palavra-passe da área administrativa do catálogo.
ADMIN_PASSWORD=
# Identificador opcional da conta administrativa.
ADMIN_OPEN_ID=
  # Vercel Blob Store para imagens públicas de receitas.
  BLOB_READ_WRITE_TOKEN=
  # S3 legado, usado apenas por fluxos antigos que ainda não migraram.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Endpoint, região e bucket do armazenamento compatível com S3.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
S3_BUCKET_NAME=
# Porta local do servidor Express.
PORT=
# Token Bearer legado. O servidor o trata como escopo publish,
# sempre sujeito a AGENT_PUBLISHING_ENABLED=true e AGENT_PHASE >= 1.
RECIPES_AGENT_TOKEN=
# Tokens com escopo separado do contrato v1 (preferíveis ao token legado).
RECIPES_AGENT_TOKEN_DRAFT=
RECIPES_AGENT_TOKEN_PUBLISH=
# Controles fail-closed para publicação automatizada.
AGENT_PHASE=0
AGENT_PUBLISHING_ENABLED=false
AGENT_APPROVED_MODELS=
AGENT_DAILY_CAP_RECIPES=1
AGENT_DAILY_CAP_ARTICLES=2
AGENT_DAILY_CAP_DRAFTS=3
AGENT_IMAGE_GENERATION_ENABLED=false
# Domínio canônico usado nas URLs retornadas pela API.
SITE_PUBLIC_URL=https://www.chocolicia.site
# Token Bearer para o cron e para o endpoint /api/recipes/generate-daily.
CRON_SECRET=
# Controla se receitas geradas são publicadas ou guardadas como rascunhos.
AUTO_PUBLISH=
  # Provedores de texto, em ordem de tentativa. Gemini, Groq e OpenRouter são suportados.
  RECIPES_TEXT_PROVIDERS=gemini,groq,openrouter,openai
  GEMINI_API_KEY=
  GROQ_API_KEY=
  OPENROUTER_API_KEY=
  GEMINI_TEXT_MODEL=gemini-2.5-flash
  GROQ_TEXT_MODEL=llama-3.3-70b-versatile
  OPENROUTER_TEXT_MODEL=openai/gpt-4o-mini
  # Provedores de imagem, em ordem de tentativa. Gemini usa Imagen; OpenAI é fallback opcional.
  RECIPES_IMAGE_PROVIDERS=gemini,openai
  GEMINI_IMAGE_MODEL=imagen-4.0-generate-001
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Identificadores dos modelos de texto e imagem usados pelo agente.
RECIPES_TEXT_MODEL=
RECIPES_IMAGE_MODEL=
# URL pública/CDN base para servir imagens publicadas de receitas.
RECIPES_PUBLIC_BASE_URL=
