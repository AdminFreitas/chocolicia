# PostgreSQL/Neon: URL de ligação do servidor à base de dados.
DATABASE_URL=
# Alias opcional de DATABASE_URL usado pelo Drizzle Kit.
NEON_DATABASE_URL=
# Assinatura das sessões administrativas; definir como segredo aleatório forte.
JWT_SECRET=
# Palavra-passe da área administrativa do catálogo.
ADMIN_PASSWORD=
# Identificador opcional da conta administrativa.
ADMIN_OPEN_ID=
# Token do Vercel Blob Store usado para imagens públicas do catálogo e receitas.
BLOB_READ_WRITE_TOKEN=
# Porta local do servidor Express.
PORT=
# Token Bearer para publicação de receitas pelo endpoint /api/recipes.
RECIPES_AGENT_TOKEN=
# Token Bearer para o cron e para o endpoint /api/recipes/generate-daily.
CRON_SECRET=
# Controla se receitas geradas são publicadas ou guardadas como rascunhos.
AUTO_PUBLISH=
# Provedores de texto: auto, ollama, gemini, groq ou openrouter.
RECIPES_TEXT_PROVIDER=auto
RECIPES_TEXT_MODEL=
OLLAMA_MODEL=
OLLAMA_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
GROQ_BASE_URL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=
# Imagem é independente do texto e aceita uma API compatível com OpenAI Images.
RECIPES_IMAGE_PROVIDER=openai-compatible
RECIPES_IMAGE_API_KEY=
RECIPES_IMAGE_API_BASE_URL=
RECIPES_IMAGE_MODEL=gpt-image-1
# Compatibilidade legada: usados como fallback somente para a geração de imagem.
OPENAI_API_KEY=
OPENAI_BASE_URL=
